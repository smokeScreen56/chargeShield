# ChargeShield Gateway Environment Configuration

PORT=5000

# MongoDB Persistence URI
# Optional: Gateway automatically falls back to robust In-Memory cache if MongoDB is offline
MONGO_URI=mongodb://127.0.0.1:27017/chargeshield

# Upstream OCPP 1.6J Central System (CSMS)
# Optional: If configured, allowed/alerted frames are relayed upstream, and responses returned to chargers.
# Leave blank to operate in standalone gateway mode.
CSMS_URL=
